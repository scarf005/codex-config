# Track maintained configuration only; private state and downloaded caches stay local.
/*
!/.gitignore
!/.pre-commit-config.yaml
!/justfile
!/AGENTS.md
!/config.toml
!/safe-yolo.config.toml
!/agents/
!/skills/

# Bundled skills are generated, except the customized OpenAI Docs skill.
/skills/.system/*
!/skills/.system/openai-docs/

# Generated files inside maintained directories.
**/__pycache__/
**/*.pyc
**/node_modules/
